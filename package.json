{
  "name": "google-maps-js-api-react",
  "version": "5.0.1",
  "description": "Lightweight, tree-shakable React components and hooks for the Google Maps JavaScript API — Suspense-based loading and pooled, reusable map instances",
  "author": "Krombik",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Krombik/google-maps-react.git"
  },
  "bugs": {
    "url": "https://github.com/Krombik/google-maps-react/issues"
  },
  "homepage": "https://github.com/Krombik/google-maps-react#readme",
  "type": "module",
  "source": "src/index.ts",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsdown",
    "watch": "tsdown --watch",
    "release": "tsdown && npm publish ./build"
  },
  "peerDependencies": {
    "@types/google.maps": ">=3.51.0",
    "@types/react": ">=18.0.0",
    "google-maps-js-api-loader": ">=4.0.2",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "@types/google.maps": {
      "optional": true
    }
  },
  "dependencies": {
    "lodash.noop": "^3.0.1",
    "react-helpful-utils": "^1.0.6"
  },
  "devDependencies": {
    "@types/google.maps": "3.65.0",
    "@types/lodash.noop": "^3.0.9",
    "@types/node": "^20.12.12",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.3.0",
    "google-maps-js-api-loader": "^4.0.3",
    "prettier": "3.8.3",
    "tsdown": "^0.22.1",
    "typescript": "6.0.3",
    "unrun": "^0.3.0"
  },
  "keywords": [
    "react",
    "google",
    "google-maps",
    "maps",
    "react-google-maps",
    "google-maps-react",
    "map",
    "marker",
    "advanced-marker",
    "overlay",
    "polygon",
    "polyline",
    "circle",
    "rectangle",
    "street-view",
    "drawing-manager",
    "traffic-layer",
    "transit-layer",
    "feature-layer",
    "hooks",
    "typescript",
    "tree-shakable",
    "suspense"
  ],
  "sideEffects": false
}
